<%# Reloads the page every 5 minutes (served from memory; never calls AWS), to
    pick up new CloudWatch values and keep the "ago" times current. AWS data
    changes only a few times a day, so more often adds nothing. A later PR
    replaces this with JavaScript that updates the numbers in place. %>
<% content_for :head do %>
  <meta http-equiv="refresh" content="300">
<% end %>
<% s = @summary %>
<% estimate = s.estimated_total %>

<header>
  <h1>Cloud Cost Tracker</h1>
  <p class="headline">
    <% if s.last_updated_at %>
      Costs last updated at <strong><%= format_time(s.last_updated_at) %></strong>
      <span class="muted">(<%= age(s.last_updated_at, s.now) %>)</span>
    <% else %>
      Costs not loaded yet. The first fetch runs when the app starts; this page reloads every 5 minutes.
    <% end %>
  </p>
  <ul class="as-of">
    <li>Current charges (CloudWatch): <%= as_of(s.current_charges_as_of, s.now, loaded: s.cloudwatch_loaded?) %></li>
    <li>Estimated total and by service (Cost Explorer): <%= as_of(s.cost_explorer_as_of, s.now, loaded: s.cost_explorer_loaded?) %></li>
    <li>Previous 3 months (Cost Explorer): <%= as_of(s.history_as_of, s.now, loaded: s.history_loaded?) %></li>
  </ul>
</header>

<section class="figures">
  <div class="figure">
    <h2>Current charges</h2>
    <p class="amount" id="current-charges">
      <% if !s.cloudwatch_loaded? %>Loading…<% elsif s.current_charges.nil? %>No data yet this period<% else %><%= usd(s.current_charges) %><% end %>
    </p>
    <p class="detail">Month to date, CloudWatch estimate</p>
    <% if (failure = refresh_failure(s.cloudwatch_error)) %><p class="warning"><%= failure %></p><% end %>
  </div>

  <div class="figure">
    <h2>Estimated total for <%= s.period.start_date.strftime("%B") %></h2>
    <p class="amount" id="estimated-total"><%= estimate ? usd(estimate.amount) : "Loading…" %></p>
    <% if estimate %>
      <p class="detail"><%= estimate_label(estimate) %></p>
      <% if estimate.low && estimate.high %>
        <p class="detail">Likely range: <%= usd(estimate.low) %> – <%= usd(estimate.high) %></p>
      <% end %>
      <p class="detail">Month to date (Cost Explorer): <%= usd(s.month_to_date) %></p>
      <% if (note = forecast_note(estimate)) %><p class="detail"><%= note %></p><% end %>
    <% end %>
    <% if (failure = refresh_failure(s.cost_explorer_error)) %><p class="warning"><%= failure %></p><% end %>
  </div>
</section>

<% if (b = s.breakdown) %>
  <section>
    <h2 class="section-title">This month by service</h2>
    <table class="costs" id="by-service">
      <thead><tr><th scope="col">Service</th><th scope="col" class="num">Cost</th><th scope="col" class="num">Share</th></tr></thead>
      <tbody>
        <% (b.rows + [b.other].compact).each do |row| %>
          <tr<% if row.bedrock %> class="bedrock"<% end %>>
            <th scope="row"><%= row.name %><% if row.bedrock %> <span class="tag">Bedrock model</span><% end %></th>
            <td class="num"><%= usd(row.current) %></td>
            <td class="num"><%= (pct = b.share(row.current)) ? "#{pct}%" : "–" %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot><tr><th scope="row">Total</th><td class="num"><%= usd(b.totals.current) %></td><td></td></tr></tfoot>
    </table>
  </section>

  <section>
    <h2 class="section-title">Previous 3 months</h2>
    <% if b.months.empty? %>
      <p class="detail"><%= s.history_error ? refresh_failure(s.history_error) : "Loading…" %></p>
    <% else %>
      <div class="scroll">
        <table class="costs" id="comparison">
          <thead>
            <tr>
              <th scope="col">Service</th>
              <% b.months.each do |m| %><th scope="col" class="num"><%= m.strftime("%b") %></th><% end %>
              <th scope="col" class="num"><%= s.period.start_date.strftime("%b") %>*</th>
            </tr>
          </thead>
          <tbody>
            <% (b.rows + [b.other].compact).each do |row| %>
              <tr<% if row.bedrock %> class="bedrock"<% end %>>
                <th scope="row"><%= row.name %></th>
                <% b.months.each do |m| %><td class="num"><%= usd(row.months[m]) %></td><% end %>
                <td class="num"><%= usd(row.current) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Total</th>
              <% b.months.each do |m| %><td class="num"><%= usd(b.totals.months[m]) %></td><% end %>
              <td class="num"><%= usd(b.totals.current) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="detail">* Month to date. Rows are this month's top 10 services plus every Bedrock model; other services are in "Other".</p>
      <% if (failure = refresh_failure(s.history_error)) %><p class="warning"><%= failure %></p><% end %>
    <% end %>
  </section>
<% end %>

<dl class="period">
  <dt>Today (UTC)</dt>
  <dd><%= format_date(s.period.today) %></dd>
  <dt>Billing period</dt>
  <dd><%= format_date(s.period.start_date) %> – <%= format_date(s.period.last_date) %></dd>
  <dt>Day</dt>
  <dd id="day-of-period"><%= s.period.day_number %> of <%= s.period.days_in_period %></dd>
</dl>

<footer>
  <p>AWS cost data lags actual usage by several hours. CloudWatch and Cost Explorer update at different times, so their
    figures can differ slightly.</p>
  <p>Version: <%= @app_version %></p>
</footer>
