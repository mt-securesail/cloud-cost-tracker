<%# Rendered from the same payload as GET /summary.json (SummaryPayloadHelper).
    app/javascript/dashboard.js polls that endpoint every 5 minutes and
    rebuilds the elements with these ids in place, so keep the two in step.
    Page views and polls read memory only; they never call AWS. %>
<% content_for :head do %>
  <%# Without JavaScript, fall back to reloading the whole page. %>
  <noscript><meta http-equiv="refresh" content="<%= HomeController::POLL_SECONDS %>"></noscript>
  <script src="<%= dashboard_script_path %>" defer></script>
<% end %>
<% p = @payload %>

<div id="dashboard" data-version="<%= p[:version] %>" data-poll-seconds="<%= HomeController::POLL_SECONDS %>">
  <header>
    <h1>Cloud Cost Tracker</h1>
    <p class="headline" id="headline">
      <% if p[:last_updated_at] %>
        Costs last updated at <strong><%= local_time_tag(p[:last_updated_at]) %></strong>
        <%= age_tag(p[:last_updated_at], p[:now]) %>
      <% else %>
        <%= p[:not_loaded_text] %>
      <% end %>
    </p>
    <p class="warning" id="connection" hidden></p>
    <ul class="as-of" id="sources">
      <% p[:sources].each do |src| %>
        <li>
          <%= src[:label] %>:
          <% if src[:as_of] %><%= local_time_tag(src[:as_of]) %> <%= age_tag(src[:as_of], p[:now]) %><% else %><%= src[:placeholder] %><% end %>
          <% if src[:stale] %><span class="stale"><%= src[:stale] %></span><% end %>
        </li>
      <% end %>
    </ul>
  </header>

  <section class="figures" id="figures">
    <div class="figure">
      <h2>Current charges</h2>
      <p class="amount" id="current-charges"><%= p[:current_charges][:amount] %></p>
      <p class="detail">Month to date, CloudWatch estimate</p>
      <% if p[:current_charges][:warning] %><p class="warning"><%= p[:current_charges][:warning] %></p><% end %>
    </div>

    <div class="figure">
      <% e = p[:estimated_total] %>
      <h2><%= e[:title] %></h2>
      <p class="amount" id="estimated-total"><%= e[:amount] %></p>
      <% e[:details].each do |detail| %><p class="detail"><%= detail %></p><% end %>
      <% if e[:warning] %><p class="warning"><%= e[:warning] %></p><% end %>
    </div>
  </section>

  <div id="breakdown">
    <% if (b = p[:breakdown]) %>
      <section>
        <h2 class="section-title">This month by service</h2>
        <table class="costs" id="by-service">
          <thead><tr><th scope="col">Service</th><th scope="col" class="num">Cost</th><th scope="col" class="num">Share</th></tr></thead>
          <tbody>
            <% b[:rows].each do |row| %>
              <tr<% if row[:bedrock] %> class="bedrock"<% end %>>
                <th scope="row"><%= row[:name] %><% if row[:bedrock] %> <span class="tag">Bedrock model</span><% end %></th>
                <td class="num"><%= row[:current] %></td>
                <td class="num"><%= row[:share] %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot><tr><th scope="row">Total</th><td class="num"><%= b[:total][:current] %></td><td></td></tr></tfoot>
        </table>
      </section>

      <section>
        <h2 class="section-title">Previous 3 months</h2>
        <% if b[:history_message] %>
          <p class="detail"><%= b[:history_message] %></p>
        <% else %>
          <div class="scroll">
            <table class="costs" id="comparison">
              <thead>
                <tr>
                  <th scope="col">Service</th>
                  <% b[:months].each do |m| %><th scope="col" class="num"><%= m %></th><% end %>
                  <th scope="col" class="num"><%= b[:current_month] %>*</th>
                </tr>
              </thead>
              <tbody>
                <% b[:rows].each do |row| %>
                  <tr<% if row[:bedrock] %> class="bedrock"<% end %>>
                    <th scope="row"><%= row[:name] %></th>
                    <% row[:months].each do |amount| %><td class="num"><%= amount %></td><% end %>
                    <td class="num"><%= row[:current] %></td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <tr>
                  <th scope="row">Total</th>
                  <% b[:total][:months].each do |amount| %><td class="num"><%= amount %></td><% end %>
                  <td class="num"><%= b[:total][:current] %></td>
                </tr>
              </tfoot>
            </table>
          </div>
          <p class="detail"><%= b[:footnote] %></p>
          <% if b[:history_warning] %><p class="warning"><%= b[:history_warning] %></p><% end %>
        <% end %>
      </section>
    <% end %>
  </div>

  <dl class="period" id="period">
    <dt>Today (UTC)</dt>
    <dd><%= p[:period][:today] %></dd>
    <dt>Billing period</dt>
    <dd><%= p[:period][:range] %></dd>
    <dt>Day</dt>
    <dd id="day-of-period"><%= p[:period][:day] %></dd>
  </dl>

  <footer>
    <p>AWS cost data lags actual usage by several hours. CloudWatch and Cost Explorer update at different times, so their
      figures can differ slightly. Times are in your browser's time zone; the billing period is in UTC.</p>
    <p>Version: <%= p[:version] %></p>
  </footer>
</div>
