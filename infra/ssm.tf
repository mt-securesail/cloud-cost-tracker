# The Rails secret (SECRET_KEY_BASE), generated by Terraform and stored
# encrypted in SSM Parameter Store. ECS injects it into the container.
#
# The value is ephemeral and write-only: Terraform sends it to AWS but never
# saves it in the state file or plan, and nobody passes it in. It's written
# only when value_wo_version changes, so routine runs (such as the app_enabled
# switch) leave it alone. To rotate it, increase value_wo_version and apply.
#
# SSM reserves parameter names that start with "aws" or "ssm"
# (case-insensitive), so the secret sits under /apps/.
ephemeral "random_password" "secret_key_base" {
  length  = 128
  special = false
}

resource "aws_ssm_parameter" "secret_key_base" {
  name             = "/apps/${var.project_name}/SECRET_KEY_BASE"
  type             = "SecureString"
  value_wo         = ephemeral.random_password.secret_key_base.result
  value_wo_version = 1
}
