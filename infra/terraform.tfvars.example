# Copy this to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored. Never commit real values, especially secret_key_base or your IP.

aws_region   = "us-east-1"
project_name = "cloud-cost-tracker"
github_org   = "your-github-username"
github_repo  = "cloud-cost-tracker"

# From: gh api repos/OWNER/REPO/actions/oidc/customization/sub (the sub_claim_prefix value)
github_oidc_sub_prefix = "repo:your-github-username@123/cloud-cost-tracker@456"

domain_name   = "example.com"
app_subdomain = "cloud-cost-est"

# Who can reach the load balancer. Use your own public IP with /32.
# Find it with: curl -s https://checkip.amazonaws.com
allowed_cidrs = ["203.0.113.7/32"]

# On/off switch: false removes the load balancer, ECS service, and DNS record.
app_enabled = true

# Do NOT put secret_key_base here. Pass it at apply time instead:
#   terraform apply -var="secret_key_base=$(openssl rand -hex 64)"
